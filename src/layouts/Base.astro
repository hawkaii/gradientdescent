---
const {
  title = 'Gradient Descent',
  description = 'Every hobby is a company waiting to happen. We build the software, the audience, and the machine that runs them.',
} = Astro.props as { title?: string; description?: string };
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat+Brush&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
    <script is:inline>
      (function () {
        var els = Array.prototype.slice.call(document.querySelectorAll('.reveal'));
        var reduced = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!('IntersectionObserver' in window) || reduced) {
          els.forEach(function (el) { el.classList.add('in'); });
        } else {
          els.forEach(function (el) { el.classList.add('pending'); });
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (e) {
              if (e.isIntersecting) {
                e.target.classList.add('in');
                io.unobserve(e.target);
              }
            });
          }, { threshold: 0.12, rootMargin: '0px 0px -60px 0px' });
          els.forEach(function (el) { io.observe(el); });
        }

        // Scroll-driven reel stack: each step of the pin reveals one more video.
        var pin = document.querySelector('.reel-pin');
        if (pin) {
          var cards = Array.prototype.slice.call(pin.querySelectorAll('.reel-card'));
          var vids = cards.map(function (c) { return c.querySelector('video'); }).filter(Boolean);
          var caption = pin.querySelector('[data-reel-caption]');
          var idxEl = pin.querySelector('[data-reel-index]');
          var lastCount = 0;

          var updateStack = function () {
            var rect = pin.getBoundingClientRect();
            var travel = pin.offsetHeight - window.innerHeight;
            var progress = travel > 0 ? -rect.top / travel : 0;
            progress = Math.max(0, Math.min(1, progress));

            var count = Math.max(1, Math.min(cards.length, Math.ceil(progress * cards.length)));

            if (count !== lastCount) {
              cards.forEach(function (card, i) {
                card.classList.toggle('is-revealed', i < count);
                card.classList.toggle('is-behind', i < count - 1);
              });

              var top = cards[count - 1];
              if (top) {
                var label = top.getAttribute('data-label') || '';
                if (caption) caption.textContent = label;
                if (idxEl) idxEl.textContent = String(count);
              }

              vids.forEach(function (video, i) {
                if (i === count - 1) {
                  var pr = video.play();
                  if (pr && pr.catch) pr.catch(function () {});
                } else if (!video.paused) {
                  video.pause();
                }
              });

              lastCount = count;
            }
          };

          updateStack();
          window.addEventListener('scroll', updateStack, { passive: true });
          window.addEventListener('resize', updateStack);

          if (reduced) {
            cards.forEach(function (card) { card.classList.add('is-revealed'); });
          }
        }

        var nums = Array.prototype.slice.call(document.querySelectorAll('[data-count]'));
        if (nums.length && 'IntersectionObserver' in window && !reduced) {
          var host = nums[0].closest('.stats') || nums[0];
          var cio = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
              if (!entry.isIntersecting) return;
              nums.forEach(function (el) {
                var target = Number(el.getAttribute('data-count'));
                if (isNaN(target)) return;
                var start = performance.now(), dur = 1100;
                function step(now) {
                  var p = Math.min(1, (now - start) / dur);
                  var eased = 1 - Math.pow(1 - p, 3);
                  el.textContent = String(Math.round(target * eased));
                  if (p < 1) requestAnimationFrame(step);
                }
                requestAnimationFrame(step);
              });
              cio.disconnect();
            });
          }, { threshold: 0.4 });
          cio.observe(host);
        }
      })();
    </script>
  </body>
</html>
