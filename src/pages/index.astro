---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const products = (await getCollection('products'))
  .filter((p) => p.data.status !== 'planned')
  .sort((a, b) => a.data.order - b.data.order);

const live = products.filter((p) => p.data.status === 'live').length;
const building = products.filter((p) => p.data.status === 'building').length;

const statusLabel: Record<string, string> = {
  live: 'LIVE',
  alpha: 'ALPHA',
  building: 'BUILDING',
  planned: 'PLANNED',
};
const statusClass: Record<string, string> = {
  live: 'live',
  alpha: 'live',
  building: 'building',
  planned: 'planned',
};
---
<Base title="Gradient Descent — Every hobby. Solved whole.">
  <!-- Nav -->
  <nav class="nav">
    <a href="/" class="wordmark">GRADIENT DESCENT</a>
    <div class="links">
      <a href="#products">Products</a>
      <a href="#approach">Approach</a>
      <a href="#contact">Contact</a>
      <a href="mailto:hello@gradientdescent.wiki" class="btn" style="padding:6px 12px;font-size:12px;">Say hello</a>
    </div>
  </nav>

  <!-- Hero -->
  <section class="hero">
    <div class="eyebrow">// gradient_descent.exe</div>
    <h1>EVERY HOBBY.<br/>SOLVED WHOLE<span class="cursor"></span></h1>
    <p class="sub">
      We build the software, the content and the audience. Each product takes one thing
      people do for love and finishes the job. Nothing is outsourced.
    </p>
    <div class="cta">
      <a href="#products" class="btn">Browse products</a>
      <a href="#contact" class="btn ghost">Say hello</a>
    </div>
    <div class="count">
      {live} LIVE · {building} BUILDING · {products.length} TOTAL
    </div>

    <!-- Status board -->
    <div class="status-board">
      {products.map((p) => (
        <div class="status-row">
          <span><span class={`dot ${p.data.status === 'building' ? 'building' : ''}`}></span>{p.data.name.toUpperCase()}</span>
          <span>{statusLabel[p.data.status]} · {p.data.kind.toUpperCase()}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- Products -->
  <section id="products" class="section">
    <h2 class="section-title reveal">01 · THE LINEUP</h2>
    <p class="section-sub reveal">One product per hobby. Wide cards, honest badges.</p>
    <div class="grid">
      {products.map((p) => (
        <article class="card block reveal">
          <div class="shot">
            <span>{p.data.name}</span>
          </div>
          <div class="body">
            <span class={`badge ${statusClass[p.data.status]}`}>{statusLabel[p.data.status]}</span>
            <h3 class="name">{p.data.name}</h3>
            <p class="tagline">{p.data.tagline}</p>
            <div class="chips">
              <span class="chip">{p.data.kind.toUpperCase()}</span>
              {p.data.platforms.map((pl) => (
                <span class="chip">{pl.toUpperCase()}</span>
              ))}
            </div>
            {p.data.url && (
              <a href={p.data.url} class="link" target="_blank" rel="noopener">
                {p.data.kind === 'channel' ? 'Watch →' : 'Open →'}
              </a>
            )}
          </div>
        </article>
      ))}
      <article class="card block reveal" style="border-style: dashed; opacity: 0.6;">
        <div class="shot" style="background: transparent;">
          <span style="color: var(--text-dim);">+</span>
        </div>
        <div class="body">
          <span class="badge building">BUILDING</span>
          <h3 class="name" style="color: var(--text-dim);">More in the workshop</h3>
          <p class="tagline">Two more verticals. Cooking. Sport.</p>
        </div>
      </article>
    </div>
  </section>

  <!-- Approach -->
  <section id="approach" class="section">
    <h2 class="section-title reveal">02 · APPROACH</h2>
    <p class="section-sub reveal">Six rules. Each one must be true today or it gets cut.</p>
    <div class="rules">
      <div class="rule block reveal">
        <div class="num">01</div>
        <h3>One hobby, one product</h3>
        <p>No platforms. No ten-tools-in-one. One job, finished.</p>
      </div>
      <div class="rule block reveal">
        <div class="num">02</div>
        <h3>Built whole</h3>
        <p>Software, content and audience ship together. Not code alone.</p>
      </div>
      <div class="rule block reveal">
        <div class="num">03</div>
        <h3>Built to run itself</h3>
        <p>A product that needs a full-time operator has failed.</p>
      </div>
      <div class="rule block reveal">
        <div class="num">04</div>
        <h3>Small on purpose</h3>
        <p>Few products. Finished. Not a catalogue.</p>
      </div>
      <div class="rule block reveal">
        <div class="num">05</div>
        <h3>Own the customer</h3>
        <p>No marketplace rent. They arrive at your door.</p>
      </div>
      <div class="rule block reveal">
        <div class="num">06</div>
        <h3>Ship often</h3>
        <p>State badges tell the truth either way.</p>
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="section">
    <h2 class="section-title reveal">03 · CONTACT</h2>
    <p class="section-sub reveal">Build with us. Or just say hello.</p>
    <div class="block reveal" style="padding: 32px; max-width: 640px;">
      <p style="margin-bottom: 20px; color: var(--text-dim);">
        Small studio. Few products. Open to the right collaborator.
      </p>
      <a href="mailto:hello@gradientdescent.wiki" class="btn">hello@gradientdescent.wiki</a>
    </div>
  </section>

  <!-- Footer -->
  <footer class="footer">
    <div style="display:flex; flex-wrap:wrap; gap:32px; justify-content:space-between; max-width:1200px; margin:0 auto;">
      <div>
        <div class="px" style="font-size:20px; color:var(--pink); margin-bottom:8px;">GRADIENT DESCENT</div>
        <div style="color:var(--text-dim); font-size:14px;">A product for every hobby.</div>
      </div>
      <div>
        <div class="px" style="font-size:12px; color:var(--text-dim); margin-bottom:8px;">PRODUCTS</div>
        {products.map((p) => (
          <div style="font-size:14px; margin-bottom:4px;">
            <a href={p.data.url} target="_blank" rel="noopener">{p.data.name}</a>
          </div>
        ))}
      </div>
      <div>
        <div class="px" style="font-size:12px; color:var(--text-dim); margin-bottom:8px;">SOCIAL</div>
        <div style="font-size:14px; margin-bottom:4px;"><a href="https://instagram.com/setefootball.mp4" target="_blank" rel="noopener">Instagram</a></div>
        <div style="font-size:14px; margin-bottom:4px;"><a href="https://github.com" target="_blank" rel="noopener">GitHub</a></div>
      </div>
    </div>
    <div class="line">Descent is how we climb.</div>
  </footer>
</Base>