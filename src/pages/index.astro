---
import Base from '../layouts/Base.astro';
import BrandPage from '../components/BrandPage.tsx';
import { getCollection } from 'astro:content';

const products = (await getCollection('products'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((p) => ({
    name: p.data.name,
    tagline: p.data.tagline,
    status: p.data.status,
    kind: p.data.kind,
    platforms: p.data.platforms,
    url: p.data.url,
    logo: p.data.logo,
    image: p.data.image,
    screenshots: p.data.screenshots,
    video: p.data.video,
  }));
---
<Base title="Gradient Descent — Every hobby is a company waiting to happen.">
  <BrandPage products={products} />
</Base>